VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Local development only. Production builds ignore this value.
VITE_DEV_AUTH_BYPASS=false

# Admin-only biometric processing. Use an ArcFace-compatible 112x112 ONNX model.
VITE_FACE_EMBEDDING_MODEL=/models/face-embedding.onnx
# Optional tuning. Defaults are suitable for ArcFace cosine matching.
VITE_FACE_MATCH_THRESHOLD=0.58
VITE_FACE_MATCH_MARGIN=0.06
