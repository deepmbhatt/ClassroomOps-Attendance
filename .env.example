VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Local development only. Production builds ignore this value.
VITE_DEV_AUTH_BYPASS=false

# Recommended lightweight recognizer: OpenCV SFace (36.9 MB, 112x112).
VITE_FACE_EMBEDDING_MODEL=/models/face-recognition-sface-2021dec.onnx
# Change this value whenever the ONNX model file changes, then reprocess all enrollments.
VITE_FACE_MODEL_VERSION=opencv-sface-2021dec-v1
VITE_FACE_MODEL_FAMILY=sface
# Precise landmarks are loaded only while capturing or verifying a face.
VITE_FACE_LANDMARKER_MODEL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
# Optional tuning. SFace's published cosine baseline is 0.363.
# Lower detector confidence helps older or noisy webcams locate a face.
VITE_FACE_DETECTION_CONFIDENCE=0.45
VITE_FACE_MATCH_THRESHOLD=0.363
VITE_FACE_MATCH_MARGIN=0.04
