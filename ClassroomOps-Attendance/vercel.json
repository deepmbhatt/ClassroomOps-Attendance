{
  "routes": [
    {
      "src": "/models/(.*)",
      "dest": "/models/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/octet-stream"
      }
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
